{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spoonbowl",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist",
  },
  "routes": [{ "pattern": "spoonbowl.engg.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
}
