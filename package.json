{
  "name": "spoonbowl",
  "private": true,
  "version": "2.2.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "fix": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "deploy": "pnpm check && pnpm build && pnpm check:dist && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jost": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.4.4",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@vite-pwa/astro>astro": "7",
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
