---
import type { Recipe } from "@/lib/api"
import { recipePath } from "@/lib/utils/slug"
import "@/styles/showcase.css"

export interface Props {
  dishes: Recipe[]
}

const { dishes } = Astro.props
const first = dishes[0]
const minutes = (dish: Recipe): number => dish.prepTimeMinutes + dish.cookTimeMinutes
---

{first && (
  <section class="showcase wrap" aria-labelledby="showcase-heading" data-showcase>
    <div class="showcase__stage" data-reveal>
      <div class="showcase__disc" aria-hidden="true"></div>
      <div class="showcase__photo bowl-mask shutter">
        <img
          src={first.image}
          alt={first.name}
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
          data-showcase-photo
        />
      </div>
    </div>
    <div class="showcase__list">
      <h2 id="showcase-heading" class="showcase__heading" data-reveal>
        Tonight, maybe
      </h2>
      <ul class="showcase__links" aria-label="Featured recipes">
        {dishes.map((dish) => (
          <li>
            <a href={recipePath(dish)}>{dish.name}</a>
          </li>
        ))}
      </ul>
      <div class="showcase__picker" role="group" aria-label="Pick a dish" data-showcase-picker>
        {dishes.map((dish, index) => (
          <button
            type="button"
            aria-pressed={index === 0 ? "true" : "false"}
            data-name={dish.name}
            data-image={dish.image}
            data-minutes={minutes(dish)}
            data-href={recipePath(dish)}
          >
            {dish.name}
          </button>
        ))}
      </div>
      <p class="showcase__fact" aria-live="polite">
        <span data-showcase-minutes>{minutes(first)}</span> minutes, start to plate.
        <a class="text-link" href={recipePath(first)} data-showcase-open>
          Open the recipe
        </a>
      </p>
    </div>
  </section>
)}

<script>
  import { initShowcase } from "@/scripts/showcase"
  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach(initShowcase)
</script>
