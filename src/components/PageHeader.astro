---
import PageHeadPhotos from "@/components/PageHeadPhotos.astro"

export interface Props {
  title: string
  intro?: string
  count?: string
  images?: string[]
}

const { title, intro, count, images = [] } = Astro.props
---

<header class="page-head pt-8">
  <div>
    <h1 class="page-title" data-reveal>
      {title}
    </h1>
    {count && (
      <p class="mt-6 flex items-center gap-3 text-lead" data-reveal style="--i: 1">
        <span class="bowl-bullet" aria-hidden="true"></span>
        {count}
      </p>
    )}
    {intro && (
      <p class="muted mt-3 max-w-[65ch] text-lead" data-reveal style="--i: 2">
        {intro}
      </p>
    )}
  </div>
  <PageHeadPhotos images={images} />
</header>
