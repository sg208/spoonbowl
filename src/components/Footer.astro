---
import { browseLinks, siteLinks } from "@/lib/config/navigationLinks"

const currentYear = new Date().getFullYear()
const linkClass = "inline-flex min-h-12 items-center text-small hover:text-accent hover:underline"
---

<footer class="mt-24 bg-surface pb-8 pt-16" data-reveal>
  <div class="wrap">
    <p class="mark">
      Spoonbowl<span class="mark__bowl" aria-hidden="true"></span>
    </p>
    <p class="mt-4 max-w-xl text-lead">
      Recipes you can cook from, at the counter, with or without signal.
    </p>
    <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-12">
      <nav aria-label="Browse links" class="md:col-span-3">
        <h2 class="text-lead font-medium">Browse</h2>
        <ul>
          {browseLinks.map((link) => (
            <li>
              <a href={link.to} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Site information" class="md:col-span-3">
        <h2 class="text-lead font-medium">Information</h2>
        <ul>
          {siteLinks.map((link) => (
            <li>
              <a href={link.to} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="col-span-2 md:col-span-5 md:col-start-8">
        <h2 class="text-lead font-medium">Good to know</h2>
        <p class="mt-3 max-w-md">
          Discover delicious recipes from around the world. Cook with joy, eat with love.
        </p>
        <p class="muted mt-3 max-w-md text-small">Recipe data and photographs from DummyJSON.</p>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <p class="muted text-small">© {currentYear} Spoonbowl.</p>
        <a
          href="https://github.com/sg208/spoonbowl"
          class="muted inline-flex size-8 items-center justify-center hover:text-accent"
          aria-label="Source code on GitHub (opens in a new tab)"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="size-[18px]"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
      </div>
      <a href="#main" class="bowl-button min-h-12 px-8 text-small">
        Back to top
      </a>
    </div>
  </div>
</footer>

<style>
  .mark {
    display: flex;
    align-items: flex-start;
    gap: 0.06em;
    font-size: clamp(2.5rem, 15vw, 12rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.9;
    padding-bottom: 0.18em;
  }
  .mark__bowl {
    width: 0.5em;
    height: 0.25em;
    margin-top: 0.12em;
    flex: none;
    background: var(--accent-fill);
    border-radius: var(--bowl);
  }
</style>
