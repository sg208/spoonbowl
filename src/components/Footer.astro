---
import { browseLinks, siteLinks } from "@/lib/config/navigationLinks"

const currentYear = new Date().getFullYear()
const linkClass = "inline-flex min-h-12 items-center text-small hover:text-accent hover:underline"
const letters = ["S", "P", "O", "O", "N"]
const tail = ["B", "O", "W", "L"]
---

<footer class="mt-24 bg-surface pb-8 pt-16" data-reveal>
  <div class="wrap">
    <div class="mark" role="img" aria-label="Spoonbowl">
      <div class="mark__row" aria-hidden="true">
        {letters.map((letter) => (
          <span class="mark__block">{letter}</span>
        ))}
      </div>
      <div class="mark__row" aria-hidden="true">
        <span class="mark__bowl"></span>
        {tail.map((letter) => (
          <span class="mark__block">{letter}</span>
        ))}
      </div>
    </div>
    <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-12">
      <nav aria-label="Browse links" class="md:col-span-3">
        <h2 class="text-lead font-bold">Browse</h2>
        <ul>
          {browseLinks.map((link) => (
            <li>
              <a href={link.to} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Site information" class="md:col-span-3">
        <h2 class="text-lead font-bold">Information</h2>
        <ul>
          {siteLinks.map((link) => (
            <li>
              <a href={link.to} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="col-span-2 md:col-span-5 md:col-start-8">
        <h2 class="text-lead font-bold">Good to know</h2>
        <p class="mt-3 max-w-md">
          Discover delicious recipes from around the world. Cook with joy, eat with love.
        </p>
        <p class="muted mt-3 max-w-md text-small">Recipe data and photographs from DummyJSON.</p>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
      <p class="muted text-small">© {currentYear} Spoonbowl.</p>
      <a href="#main" class="bowl-button min-h-12 px-8 text-small">
        Back to top
      </a>
    </div>
  </div>
</footer>

<style>
  .mark {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: clamp(3.5rem, 11.2vw, 10.5rem);
    font-weight: 700;
    line-height: 1;
  }
  .mark__row {
    display: flex;
    gap: 4px;
    align-items: flex-end;
  }
  @media (min-width: 900px) {
    .mark {
      flex-direction: row;
      align-items: flex-end;
    }
    .mark__row {
      flex: 1;
    }
  }
  .mark__block {
    display: flex;
    flex: 1;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0.04em;
    background: var(--ink);
    color: var(--surface);
    line-height: 0.8;
    height: calc(var(--h, 100) * 0.01em);
  }
  .mark__block:nth-child(odd) {
    --h: 100;
  }
  .mark__block:nth-child(even) {
    --h: 78;
  }
  .mark__block:nth-child(3n) {
    background: var(--muted);
    --h: 90;
  }
  .mark__bowl {
    flex: 1.2;
    height: 0.55em;
    background: var(--accent-fill);
    border-radius: var(--bowl);
    align-self: flex-start;
  }
</style>
