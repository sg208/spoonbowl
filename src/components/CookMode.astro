---
import type { Recipe } from "@/lib/api"
import { hasQuantity } from "@/lib/cook/scale"
import "@/styles/cook.css"

export interface Props {
  recipe: Recipe
}

const { recipe } = Astro.props
const hasAmounts = recipe.ingredients.some(hasQuantity)
---

<section
  class="cook"
  aria-labelledby="cook-heading"
  data-cook
  data-base-servings={recipe.servings}
  data-kcal={recipe.caloriesPerServing}
  data-has-amounts={String(hasAmounts)}
>
  <div class="wrap cook__inner">
    <h2 id="cook-heading" class="section-title cook__heading">
      Cook mode
    </h2>

    <div class="cook__servings" data-cook-servings hidden>
      <span id="cook-servings-label">Servings</span>
      <button
        type="button"
        class="cook__btn cook__btn--small"
        data-servings-minus
        aria-label="Fewer servings"
        aria-describedby="cook-servings-label"
      >
        −
      </button>
      <output class="cook__count" data-servings-count>
        {recipe.servings}
      </output>
      <button
        type="button"
        class="cook__btn cook__btn--small"
        data-servings-plus
        aria-label="More servings"
        aria-describedby="cook-servings-label"
      >
        +
      </button>
      <p class="cook__kcal">
        <span data-kcal-total>{recipe.caloriesPerServing * recipe.servings}</span> kcal in total
      </p>
      <p class="cook__note" data-amounts-note hidden>
        Amounts aren't listed for these ingredients, so only servings and calories change.
      </p>
      <p class="cook__sr" role="status" aria-live="polite" data-servings-status></p>
    </div>

    <div class="cook__cols">
      <div class="cook__col">
        <h3 class="cook__sub">Ingredients</h3>
        <ul class="cook__ingredients">
          {recipe.ingredients.map((ingredient, i) => (
            <li>
              <input type="checkbox" id={`ingredient-${i}`} />
              <label for={`ingredient-${i}`} data-ingredient={ingredient}>
                {ingredient}
              </label>
            </li>
          ))}
        </ul>
      </div>

      <div class="cook__col">
        <h3 class="cook__sub">Steps</h3>
        <ol class="cook__steps" data-steps>
          {recipe.instructions.map((step) => (
            <li>{step}</li>
          ))}
        </ol>

        <button
          type="button"
          class="cook__btn cook__btn--primary cook__start"
          data-cook-start
          hidden
        >
          Start cooking
        </button>

        <div class="cook__pager" data-cook-pager hidden>
          <p class="cook__counter" data-pager-counter></p>
          <p class="cook__step" data-pager-text></p>
          <p class="cook__sr" role="status" aria-live="polite" data-pager-status></p>
          <div class="cook__nav">
            <button type="button" class="cook__btn" data-pager-prev>
              Previous
            </button>
            <button type="button" class="cook__btn cook__btn--primary" data-pager-next>
              Next
            </button>
            <button type="button" class="cook__btn" data-pager-exit>
              Exit
            </button>
            <button type="button" class="cook__btn" data-wake-toggle aria-pressed="false" hidden>
              Keep screen on
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCookMode } from "@/scripts/cook-mode"
  document.querySelectorAll<HTMLElement>("[data-cook]").forEach(initCookMode)
</script>
