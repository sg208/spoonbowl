---
// Combobox behaviour lives in src/scripts/search.ts; markup is the no-JS-safe shell.
---

<form class="search" role="search" data-search aria-label="Recipes">
  <label class="search__label" for="search-input">
    Search recipes
  </label>
  <input
    id="search-input"
    class="search__input"
    type="search"
    name="q"
    autocomplete="off"
    spellcheck="false"
    placeholder="Search recipes"
    role="combobox"
    aria-expanded="false"
    aria-controls="search-listbox"
    aria-autocomplete="list"
    data-search-input
  />
  <div
    id="search-listbox"
    class="search__list"
    role="listbox"
    aria-label="Recipe suggestions"
    hidden
    data-search-list
  ></div>
  <p class="search__empty" hidden data-search-empty>
    No recipes match
  </p>
  <p class="search__status" role="status" aria-live="polite" data-search-status></p>
</form>

<script>
  import { initSearch } from "@/scripts/search"
  document.querySelectorAll<HTMLElement>("[data-search]").forEach(initSearch)
</script>

<style>
  .search {
    position: relative;
  }
  .search__label {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: visually hidden */
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .search__input {
    width: 100%;
    min-height: 48px;
    padding: 0 1rem;
    font: inherit;
    font-size: max(16px, 1rem);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--muted); /* taste-skill-ignore: form field */
  }
  .search__input:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .search__list,
  .search__empty {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 10;
    margin: 0;
    padding: 0;
    background: var(--surface);
    color: var(--ink);
  }
  .search__empty {
    padding: 0.75rem 1rem;
    color: var(--muted);
  }
  .search__list :global([role="option"]) {
    display: block;
  }
  .search__list :global([role="option"] a) {
    display: block;
    min-height: 48px;
    padding: 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
    font-size: 1rem;
  }
  .search__list :global([aria-selected="true"] a) {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .search__status {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: visually hidden */
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
