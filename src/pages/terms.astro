---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatPageTitle } from "@/lib/seo"

const linkClass = "underline underline-offset-4 hover:text-accent"
---

<BaseLayout
  title={formatPageTitle("Terms of use")}
  description="Terms of use for Spoonbowl, a demo recipe site: content as-is, no warranty, third-party recipes and photos."
  path="/terms/"
>
  <div class="wrap py-12">
    <div class="prose-column">
      <header class="mb-8">
        <h1 class="page-title">Terms of use</h1>
        <p class="muted">
          Spoonbowl is a demo and portfolio project. It is free to use and has no accounts or paid
          features.
        </p>
      </header>

      <div class="space-y-8">
        <section aria-labelledby="terms-content">
          <h2 id="terms-content" class="mb-3 text-lead font-bold">
            The content
          </h2>
          <p class="muted">
            Recipes, quantities and photos come from DummyJSON, a public sample-data service. They
            have not been tested by us and may be wrong or unsuitable for your diet. The
            <a href="/disclaimer/" class={linkClass}>
              disclaimer
            </a>{" "}
            covers food safety, allergies and dietary labels.
          </p>
        </section>

        <section aria-labelledby="terms-warranty">
          <h2 id="terms-warranty" class="mb-3 text-lead font-bold">
            No warranty
          </h2>
          <p class="muted">
            The site and its content are provided as is, without any warranty. It may change, break
            or go offline at any time. To the extent the law allows, we are not liable for any loss
            that comes from using it.
          </p>
        </section>

        <section aria-labelledby="terms-ownership">
          <h2 id="terms-ownership" class="mb-3 text-lead font-bold">
            Who owns what
          </h2>
          <p class="muted">
            Recipe text and photos belong to their owners and fall under DummyJSON's terms. The
            source code is public on
            <a
              href="https://github.com/sg208/spoonbowl"
              class={linkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub<span class="sr-only"> (opens GitHub in a new tab)</span>
            </a>
            under the MIT license, so you can reuse it as long as you keep the copyright notice.
            Open-source dependencies keep their own licenses.
          </p>
        </section>

        <section aria-labelledby="terms-use">
          <h2 id="terms-use" class="mb-3 text-lead font-bold">
            Fair use of the site
          </h2>
          <p class="muted">
            Please don't try to overload or attack the site. Bugs and questions are welcome on the
            <a
              href="https://github.com/sg208/spoonbowl/issues"
              class={linkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              issue tracker<span class="sr-only"> (opens GitHub in a new tab)</span>
            </a>
            .
          </p>
        </section>

        <section aria-labelledby="terms-privacy">
          <h2 id="terms-privacy" class="mb-3 text-lead font-bold">
            Privacy
          </h2>
          <p class="muted">
            What the site stores and which services your browser contacts is on the
            <a href="/privacy/" class={linkClass}>
              privacy
            </a>{" "}
            page.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
