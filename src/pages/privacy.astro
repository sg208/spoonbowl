---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatPageTitle } from "@/lib/seo"

const PRIVACY_LAST_UPDATED_ISO = "2026-11-01"
const lastUpdated = new Intl.DateTimeFormat("en-GB", { dateStyle: "long", timeZone: "UTC" }).format(
  new Date(PRIVACY_LAST_UPDATED_ISO + "T00:00:00Z")
)
const linkClass = "underline underline-offset-4 hover:text-accent"
---

<BaseLayout
  title={formatPageTitle("Privacy")}
  description="What Spoonbowl stores in your browser, which services your browser contacts, and what the host sees."
  path="/privacy/"
>
  <div class="wrap py-12">
    <div class="prose-column">
      <header class="mb-8">
        <h1 class="page-title">Privacy</h1>
        <p class="muted">
          Spoonbowl is a static recipe site. It has no accounts, no sign-up forms, no analytics, no
          advertising and no cookies. We don't collect personal data, and we have none to sell.
        </p>
      </header>

      <div class="space-y-8">
        <section aria-labelledby="privacy-host">
          <h2 id="privacy-host" class="mb-3 text-lead font-bold">
            Hosting
          </h2>
          <p class="muted">
            The site is served by a Cloudflare Worker from the domain spoonbowl.engg.app, and
            Cloudflare also runs its DNS. Like any web host, Cloudflare receives the usual request
            details when your browser asks for a page: your IP address, user agent, the address
            requested and the time. It may keep these in standard request logs. Cloudflare also asks
            your browser to report failed connections to it (Network Error Logging), so if a page
            fails to load your browser may send Cloudflare a short error report. Cloudflare's own
            privacy policy covers how it handles that data.
          </p>
        </section>

        <section aria-labelledby="privacy-third-parties">
          <h2 id="privacy-third-parties" class="mb-3 text-lead font-bold">
            Other services your browser contacts
          </h2>
          <ul class="muted list-disc space-y-2 pl-6">
            <li>
              Recipe photos load from <code>cdn.dummyjson.com</code>, the image host for DummyJSON.
              That server sees the same kind of request details as any web server.
            </li>
            <li>
              Recipe text comes from <code>dummyjson.com</code>, but only when the site is built.
              Your browser never requests recipe data from it.
            </li>
            <li>
              Links to GitHub (the source code and the issue tracker) only contact GitHub if you
              follow them.
            </li>
          </ul>
          <p class="muted mt-3">
            The Jost typeface is bundled with the site, so no font service is contacted.
          </p>
        </section>

        <section aria-labelledby="privacy-device">
          <h2 id="privacy-device" class="mb-3 text-lead font-bold">
            What stays on your device
          </h2>
          <ul class="muted list-disc space-y-2 pl-6">
            <li>
              Your light or dark theme choice is saved in localStorage under
              <code>spoonbowl-theme</code>.
            </li>
            <li>
              Ingredients you tick off in cook mode are saved in localStorage under
              <code>spoonbowl-checked-</code> followed by the recipe number, so the list survives a
              reload.
            </li>
            <li>
              A service worker caches the pages, the search index and recipe photos so the site
              works offline.
            </li>
          </ul>
          <p class="muted mt-3">
            None of this is sent anywhere. Clearing the site data in your browser removes all of it.
          </p>
        </section>

        <section aria-labelledby="privacy-contact">
          <h2 id="privacy-contact" class="mb-3 text-lead font-bold">
            Questions and changes
          </h2>
          <p class="muted mb-3 text-small">
            Last updated:
            <time datetime={PRIVACY_LAST_UPDATED_ISO}>{lastUpdated}</time>
          </p>
          <p class="muted">
            If the site starts handling data differently, this page will change first. Questions go
            to the
            <a
              href="https://github.com/sg208/spoonbowl/issues"
              class={linkClass}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub issue tracker<span class="sr-only"> (opens GitHub in a new tab)</span>
            </a>
            . The rules for using the site are on the
            <a href="/terms/" class={linkClass}>
              terms of use
            </a>{" "}
            page.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
