---
import BaseLayout from "@/layouts/BaseLayout.astro"
import HomeHero from "@/components/HomeHero.astro"
import Showcase from "@/components/Showcase.astro"
import MenuList from "@/components/MenuList.astro"
import Features from "@/components/Features.astro"
import HowItWorks from "@/components/HowItWorks.astro"
import HomeCta from "@/components/HomeCta.astro"
import { getCatalog } from "@/lib/catalog"
import { formatPageTitle } from "@/lib/seo"

const { featured, mealTypes, recipes } = await getCatalog()
const showcaseCuisines = ["Italian", "Japanese", "Mexican", "Thai", "Moroccan"]
const dishes = showcaseCuisines.flatMap((cuisine) => {
  const dish = recipes.find((recipe) => recipe.cuisine === cuisine && recipe.id !== featured.id)
  return dish ? [dish] : []
})
const menuGroups = [...mealTypes]
  .sort((left, right) => right.recipes.length - left.recipes.length)
  .slice(0, 4)
const walkthrough = recipes[5] ?? featured
const closing = recipes[15] ?? featured
const browse = [
  { to: "/recipes/cuisines/", label: "Cuisine" },
  { to: "/recipes/meal-types/", label: "Meal type" },
  { to: "/recipes/difficulties/", label: "Difficulty" },
  { to: "/recipes/tags/", label: "Category" },
]
---

<BaseLayout
  title={formatPageTitle("Recipe Discovery")}
  description="Recipes you can cook from. Browse by cuisine, meal type or difficulty, then follow one step at a time with the screen kept awake."
  path="/"
>
  <HomeHero count={recipes.length} recipe={featured} />
  <Showcase dishes={dishes} />
  <MenuList groups={menuGroups} />
  <Features recipe={recipes[20] ?? featured} />
  <HowItWorks recipe={walkthrough} />
  <section class="wrap browse" aria-labelledby="browse-heading">
    <h2 id="browse-heading" class="section-title" data-reveal>
      Browse by
    </h2>
    <p class="browse__links">
      {browse.map((link) => (
        <a class="text-link text-lead" href={link.to}>
          {link.label}
        </a>
      ))}
    </p>
  </section>
  <HomeCta recipe={closing} />
</BaseLayout>

<style>
  .browse {
    padding-top: 6rem;
  }
  .browse__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    margin-top: 1rem;
  }
</style>
