---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatPageTitle } from "@/lib/seo"
---

<BaseLayout
  title={formatPageTitle("About")}
  description="Learn about Spoonbowl, a recipe discovery app for browsing and exploring meals from around the world."
  path="/about/"
>
  <div class="wrap py-12">
    <div class="prose-column">
      <header class="mb-8">
        <h1 class="page-title">About Spoonbowl</h1>
        <p class="muted">
          Spoonbowl is a small, informal project for browsing and discovering recipes. It exists to
          make exploring meals and ideas a little easier — nothing more official than that.
        </p>
      </header>

      <div class="space-y-8">
        <section aria-labelledby="about-what">
          <h2 id="about-what" class="mb-3 text-lead font-bold">
            What this is
          </h2>
          <p class="muted">
            The site focuses on search, filters, and recipe detail pages built from third-party
            recipe data. Features may shift as the project evolves; there is no service-level
            promise beyond trying to keep things usable and honest about limits (see the
            <a href="/disclaimer/" class="underline underline-offset-4 hover:text-accent">
              Disclaimer
            </a>
            ).
          </p>
        </section>

        <section aria-labelledby="about-how">
          <h2 id="about-how" class="mb-3 text-lead font-bold">
            How it runs
          </h2>
          <p class="muted">
            Spoonbowl is built ahead of time into static pages. A Cloudflare Worker serves those
            pages from spoonbowl.engg.app, and Cloudflare also runs the DNS.
          </p>
          <p class="muted">
            What Cloudflare may log when you visit is covered in the
            <a href="/privacy/" class="underline underline-offset-4 hover:text-accent">
              Privacy
            </a>
            page.
          </p>
        </section>

        <section aria-labelledby="about-contact">
          <h2 id="about-contact" class="mb-3 text-lead font-bold">
            Contact
          </h2>
          <p class="muted">
            There is no public inbox. Questions, bugs and ideas go to the
            <a
              href="https://github.com/sg208/spoonbowl/issues"
              class="underline underline-offset-4 hover:text-accent"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub issue tracker<span class="sr-only"> (opens GitHub in a new tab)</span>
            </a>
            .
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
