---
import BaseLayout from "@/layouts/BaseLayout.astro"
import CookMode from "@/components/CookMode.astro"
import RecipeJsonLd from "@/components/RecipeJsonLd.astro"
import RecipeMeta from "@/components/RecipeMeta.astro"
import RecipeGrid from "@/components/RecipeGrid.astro"
import { getCatalog } from "@/lib/catalog"
import type { Recipe } from "@/lib/api"
import { formatRecipeTitle } from "@/lib/seo"
import { cuisineToSlug, recipePath, slugify } from "@/lib/utils/slug"

export const getStaticPaths = async () => {
  const { recipes } = await getCatalog()
  return recipes.map((recipe) => ({
    params: { id: String(recipe.id), slug: slugify(recipe.name) },
    props: {
      recipe,
      related: recipes
        .filter((other) => other.cuisine === recipe.cuisine && other.id !== recipe.id)
        .slice(0, 4),
    },
  }))
}

export interface Props {
  recipe: Recipe
  related: Recipe[]
}

const { recipe, related } = Astro.props
const totalTime = recipe.prepTimeMinutes + recipe.cookTimeMinutes
const description = `${recipe.name} — a ${recipe.difficulty.toLowerCase()} ${recipe.cuisine} recipe. Ready in ${totalTime} minutes, serves ${recipe.servings}. Full ingredients and step-by-step instructions on Spoonbowl.`
---

<BaseLayout
  title={formatRecipeTitle(recipe.name)}
  description={description}
  path={recipePath(recipe)}
  image={recipe.image}
  ogType="article"
>
  <RecipeJsonLd slot="head" recipe={recipe} description={description} />
  <article aria-labelledby="recipe-title">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="pt-6">
        <ol class="flex flex-wrap items-center gap-x-2 text-small">
          <li>
            <a href="/" class="text-link">
              Recipes
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/recipes/cuisine/${cuisineToSlug(recipe.cuisine)}/`} class="text-link">
              {recipe.cuisine}
            </a>
          </li>
        </ol>
      </nav>
      <header class="hero-recipe">
        <h1 id="recipe-title" class="page-title hero-recipe__title" data-reveal>
          {recipe.name}
        </h1>
        <div class="hero-recipe__photo bowl-mask shutter">
          <img
            src={recipe.image}
            alt={recipe.name}
            width="400"
            height="400"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="hero-recipe__facts">
          <p class="mb-8 max-w-[65ch] text-lead" data-reveal style="--i: 1">
            {recipe.difficulty} {recipe.cuisine} {recipe.mealType.join(" / ").toLowerCase()}. Ready
            in {totalTime} minutes, serves {recipe.servings}.
          </p>
          <h2 class="sr-only">Facts</h2>
          <RecipeMeta recipe={recipe} />
        </div>
      </header>
    </div>
    <div class="mt-16">
      <CookMode recipe={recipe} />
    </div>
    {related.length > 0 && (
      <section class="wrap mt-24" aria-labelledby="related-heading">
        <h2 id="related-heading" class="section-title mb-6" data-reveal>
          More {recipe.cuisine} recipes
        </h2>
        <RecipeGrid recipes={related} label={`More ${recipe.cuisine} recipes`} isLarge />
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .hero-recipe {
    display: grid;
    gap: 2rem;
    padding-block: 1.5rem 3rem;
    align-items: end;
  }
  .hero-recipe__title {
    max-width: 20ch;
  }
  .hero-recipe__photo {
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1 / 0.85;
  }
  .hero-recipe__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 900px) {
    .hero-recipe {
      grid-template-columns: 6fr 5fr;
      gap: 3rem 5rem;
      padding-block: 2rem 4rem;
    }
    .hero-recipe__title {
      grid-column: 1 / -1;
      max-width: none;
    }
    .hero-recipe__photo {
      max-width: none;
    }
  }
</style>
